<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <!--Для релизных сборок-->
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <ApplicationIcon>steamdeckviewer_icon.ico</ApplicationIcon>
        <!--Видимое имя программы; внутренние имена (пространства имён, папка настроек SteamdeckViewer, службы на Deck) прежние-->
        <AssemblyName>CarXDeckTools</AssemblyName>
        <RootNamespace>SteamdeckViewer</RootNamespace>
        <Product>CarX Deck Tools</Product>
        <AssemblyTitle>CarX Deck Tools</AssemblyTitle>
        <Description>Управление Steam Deck с ПК: сборки, отладка Rider, экран, файлы</Description>
        <Company>CarX Technologies</Company>
        <Copyright>© CarX Technologies</Copyright>
    </PropertyGroup>

    <!--Релиз (publish.bat): один exe без отладочных символов. В Debug символы остаются для отладки из IDE-->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SteamdeckViewer.Core\SteamdeckViewer.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--Иконка окна; иконка exe — ApplicationIcon выше-->
        <EmbeddedResource Include="steamdeckviewer_icon.ico" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    </ItemGroup>

    <!--pdb пакетов (libSkiaSharp, libHarfBuzzSharp и т.п.) — около 100 МБ, в релизе не нужны-->
    <Target Name="RemovePdbFromBuild" AfterTargets="ResolveReferences" Condition="'$(Configuration)' == 'Release'">
        <ItemGroup>
            <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.pdb'" />
        </ItemGroup>
    </Target>

    <Target Name="RemovePdbFromPublish" AfterTargets="ComputeFilesToPublish" Condition="'$(Configuration)' == 'Release'">
        <ItemGroup>
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
        </ItemGroup>
    </Target>

</Project>
